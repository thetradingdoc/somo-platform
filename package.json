{
  "type": "module",
  "scripts": {
    "dev:one-place": "node scripts/dev-one-place.cjs",
    "perf:lighthouse": "node perf/run-lighthouse.mjs",
    "perf:budgets": "node scripts/check-performance-budgets.cjs",
    "check:landing-routes": "node scripts/check-landing-route-canonicalization.cjs",
    "report:legacy-landing-refs": "node scripts/report-legacy-landing-references.cjs",
    "report:landing-deletion-candidates": "node scripts/report-landing-deletion-candidates.cjs",
    "retention:cleanup": "node scripts/retention-cleanup.cjs",
    "verify:agentic-checkout": "node scripts/verify-agentic-checkout.cjs",
    "ci:local": "node scripts/check-performance-budgets.cjs && node scripts/check-auth-ui-guardrails.cjs && node scripts/check-landing-route-canonicalization.cjs && RETENTION_DRY_RUN=1 node scripts/retention-cleanup.cjs && node scripts/verify-agentic-checkout.cjs && npm test --prefix middleware-platform && npm run release:security-gate --prefix middleware-platform",
    "test:landing": "npm test --prefix unified-dashboard/littlelab-landing -- --watchAll=false --runInBand",
    "test:reasoning-pipeline": "npm test --prefix middleware-platform -- --runInBand reasoning-pipeline",
    "test:food-route": "npm test --prefix unified-dashboard/littlelab-landing -- --watchAll=false --runInBand --testPathPattern=food-route",
    "test:reasoning-regression": "npm run test:reasoning-pipeline && npm run test:food-route",
    "test:reasoning-pre-ramp": "npm run test:reasoning-regression && npm run eval:reasoning:harness --prefix middleware-platform",
    "test:reasoning-release-gates": "npm run test:reasoning-pre-ramp && (test \"${REASONING_RELEASE_SKIP_E2E}\" = \"1\" || npm run test:e2e-chat-scan-gate --prefix middleware-platform)",
    "verify:reasoning:semantic-quality": "npm run verify:reasoning:semantic-quality --prefix middleware-platform",
    "verify:reasoning:production-gate": "npm run verify:reasoning:production-gate --prefix middleware-platform",
    "verify:prod:routing-smoke": "npm run verify:prod:routing-smoke --prefix middleware-platform",
    "verify:prod:full-e2e-signoff": "npm run verify:prod:full-e2e-signoff --prefix middleware-platform",
    "scheduled:reasoning-jobs-reclaim": "npm run scheduled:reasoning-jobs-reclaim --prefix middleware-platform",
    "load:reasoning-queue-smoke": "npm run load:reasoning-queue-smoke --prefix middleware-platform",
    "test:e2e-landing": "cd middleware-platform && npm run test:e2e-landing --",
    "test:e2e-landing:quick": "cd middleware-platform && npm run test:e2e-landing:quick --",
    "test:e2e-results-snapshot-batch": "npm run test:e2e-results-snapshot-batch --prefix middleware-platform",
    "check:patient-journal-funnel": "node scripts/check-patient-journal-funnel-api.mjs",
    "check:patient-journal-calendar-range": "node scripts/check-patient-journal-calendar-range-api.mjs",
    "check:patient-calendar-ui": "node scripts/check-patient-calendar-ui-playwright.mjs",
    "capture:patient-portal-screenshots": "node scripts/capture-patient-portal-screenshots.mjs",
    "deploy:landing-hosting": "REACT_APP_API_BASE=${REACT_APP_API_BASE:-https://api.myskinandcare.com} npm run build --prefix unified-dashboard/littlelab-landing && cd unified-dashboard && npx firebase-tools deploy --only hosting"
  },
  "devDependencies": {
    "@expo/ngrok": "^4.1.3",
    "chrome-launcher": "^1.2.1",
    "firebase-tools": "^13.35.1",
    "lighthouse": "^12.8.2",
    "playwright": "^1.59.1"
  }
}
