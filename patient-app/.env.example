# Copy to .env in this folder. Restart: npx expo start --clear
#
# --- Hosted demo / production API (same host for phone + Retell; no ngrok on your Mac) ---
# Verified: https://api.callsomo.com/health/live returns 200.
# Note: This uses the SERVER'S database, not your laptop SQLite. Local-only appointments
# won't appear unless they exist on that environment.
EXPO_PUBLIC_API_BASE_URL=https://api.callsomo.com
#
# --- Local middleware + ngrok (one tunnel = one port; run a second ngrok only if you need a second port) ---
# EXPO_PUBLIC_API_BASE_URL=https://your-subdomain.ngrok-free.app
#
# --- Same Wi‑Fi, no tunnel ---
# EXPO_PUBLIC_API_BASE_URL=http://192.168.1.10:4000
#
# Optional: pre-fill login (must match appointments on that API)
EXPO_PUBLIC_DEMO_PATIENT_EMAIL=doctorjay254@gmail.com
#
# Checkout chat (Explore tab → /checkout-chat): merchant catalog + default product id
# EXPO_PUBLIC_MERCHANT_ID=
# EXPO_PUBLIC_DEMO_PRODUCT_ID=prod-vitamin-c-serum-antioxidant-pro-shield
