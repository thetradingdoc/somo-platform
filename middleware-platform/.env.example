# Copy to .env and fill in secrets. Never commit .env.

# --- Database (Kelly harness: DB_FILE in scripts/run-kelly-tests.sh must match this file) ---
# Default dev file is middleware-dev.db under the data directory; override with:
# DB_PATH=middleware-dev.db

# --- Kelly LLM (see services/llm-router.js: resolvePrimaryProvider) ---
# Default primary is Claude when ANTHROPIC_API_KEY is set; use groq for Groq-only.
# KELLY_PRIMARY_PROVIDER=anthropic
ANTHROPIC_API_KEY=
KELLY_ANTHROPIC_MODEL=claude-sonnet-4-5
# KELLY_ANTHROPIC_MAX_TOKENS=2048
GROQ_API_KEY=
KELLY_GROQ_MODEL=llama-3.3-70b-versatile
KELLY_GROQ_FALLBACK_MODEL=llama-3.1-8b-instant
# Retries when Groq returns 429 / TPM (LLMRouter + Kelly still use Groq as Claude fallback)
KELLY_GROQ_MAX_RETRIES=4
KELLY_GROQ_RETRY_BASE_MS=1200
# KELLY_TURN_TIMEOUT_MS=25000
# Per-provider HTTP timeout for LLMRouter (ms). Cross-fallback (Groq→Claude) on transient errors when both keys exist.
# KELLY_PROVIDER_TIMEOUT_MS=20000
# Set to 0 to disable Groq→Anthropic fallback on errors (Groq-primary only).
# KELLY_GROQ_FALLBACK_TO_ANTHROPIC=1
# Optional copy when Kelly hits 429 / rate limits (chat / voice)
# KELLY_RATE_LIMIT_REPLY_CHAT=
# KELLY_RATE_LIMIT_REPLY_VOICE=
# Per-turn structured logs: [KellyDebug] ... (stdout)
# KELLY_DEBUG_TURN=1
# Verbose Kelly traces (contact/slot/inject/tool payloads). Off by default in production.
# KELLY_DEBUG=1
# Skip one-line Kelly startup config log on process load.
# KELLY_QUIET=1

# --- Face-read inference (teamkelly GPU service — optional) ---
# When set, POST /api/public/face-read proxies multipart "image" to ${BASE}/v1/face-read
# Start service from somo/teamkelly (see teamkelly/START_HERE.md)
# FACE_READ_INFERENCE_BASE_URL=http://127.0.0.1:8765

# Phase tool allowlists + orchestrator prompt block (see kelly-orchestrator-phase.js). Set 0 to disable.
# KELLY_ORCHESTRATOR_PHASE=0
# When 1, ROUTINE_INTAKE uses a narrow system prompt + shared safety (see kelly-prompt-builder.js). Unset/0 = full legacy prompt for all phases.
# KELLY_PHASE_PROMPTS=1

# --- Retell phone voice (TTS) ---
# Retell handles the call; voice_id picks which TTS engine/voice Retell uses (e.g. retell-Cimo, openai-Alloy, 11labs-Adrian).
# Used by configure-retell.js and RetellService.createAgent (unless clinic has its own voice_id).
# Default in code is retell-Cimo; override here if needed.
# RETELL_VOICE_ID=retell-Cimo
# RETELL_API_KEY=
# RETELL_AGENT_ID=

# --- Voice triage parity (Retell direct + Kelly) ---
# When set to 1, /voice/appointments/schedule, /available-slots, /reschedule, and /voice/insurance/collect
# require session_id or call_id in the body. Recommended for production voice.
# Retell handlers pass callId as session_id/call_id.
# REQUIRE_TRIAGE_FOR_VOICE=0

# --- Legacy unauthenticated booking API (/api/appointments/* without patient session) ---
# Set to 1 to return 410 Gone (use patient portal + /voice routes instead).
# LEGACY_APPOINTMENTS_API_DISABLED=0

# --- Payor raw data layout (NPPES, Office Ally, Inovalon) ---
# Default: middleware-platform/data/payor-sources/
# PAYOR_DATA_SOURCES_ROOT=
# Optional overrides for NPPES discovery (see scripts/payor-data-sources.cjs):
# NPPES_DISSEMINATION_DIR=/absolute/path/to/NPPES_Data_Dissemination_April_2026_V2
# NPPES_NPIDATA_CSV=/absolute/path/to/npidata_pfile_....csv
# For nppes:import-full when only a zip path is known: NPPES_ZIP_PATH=/path/to/NPPES_Data_Dissemination_*_V2.zip
# NPPES_ENDPOINT_CSV=/absolute/path/to/endpoint_pfile_....csv
# PAYOR_INGEST_METRICS_LOG_PATH=./tmp/payor-ingest-metrics.jsonl
# PAYOR_INGEST_METRICS_WEBHOOK_URL=https://example.com/ingest/payor-metrics
# Full NPPES bulk operator paths (see todos/pending/PAYOR_ENTITY_RESOLUTION_TODOS.md §13):
#   npm run run:payor:nppes-path-a  → verify sqlite + npidata path, then full CMS pipeline (long run)
#   npm run run:payor:nppes-path-b-pipeline -- --skip-migrate   → pipeline without re-importing bulk/dir/endpoints
#   npm run run:payor:nppes-path-c-manual  → ER-only chain after ingest (norm → … → canonicalization → ops)
# Step 0–2 readiness: waive Office Ally + Inovalon gates when vendor files are not procured yet:
# PAYOR_READINESS_VENDOR_MODE=cms_only
# PAYOR_CMS_AUTHORITATIVE_TRACK_ONLY=1
# Optional: add CMS baseline block to npm run report:payor:ops (same trigger as cms_only readiness above):
# PAYOR_OPS_BASELINE_MODE=cms_only
# PAYOR_OPS_STRICT_BASELINE=0
# PAYOR_OPS_CMS_MIN_NPPES_BULK_RAW=0
# AND ingest_routing.sanity_notes into report pass (see metrics.ingest_routing in npm run report:payor:ops):
# PAYOR_OPS_ROUTING_STRICT=0
# Provider + payor Jest smoke (dedup, search, network linker/drift/precheck, resolver, payor-*):
# npm run test:payor:section14-smoke
# Link Downloads folder into the tree: npm run setup:payor-data-sources:link-nppes -- /path/to/NPPES_Data_Dissemination_*_V2
# Full normalization for one source: npm run run:payor:normalization -- --until-done --source=nppes_bulk --limit=5000
# CMS-only payor pipeline (migrate → tier1 → nppes bulk → directory → endpoints → ER steps → reports; no Ally/Inovalon):
# npm run run:payor:cms-pipeline
# Confirm SQLite + NPPES CSV + nppes_bulk row counts (same DB as imports):
# npm run verify:payor:sqlite-context
# After OA/Inovalon ingests, check whether to clear cms_only waivers:
# npm run verify:payor:vendor-env
# CI-style floor on Type-2 bulk insert (exits 2 if not met): npm run import:payor:nppes-bulk -- --require-min-rows=1000

# --- Payor canonical runtime resolver (Step 8) ---
# When enabled, eligibility + claim submission routes resolve payor via canonical registry first.
# PAYOR_CANONICAL_RESOLVER_ENABLED=0
# Shadow mode logs canonical resolution decisions without changing routed payer_id.
# PAYOR_CANONICAL_RESOLVER_SHADOW=0
# Provider/payor in-network precheck in eligibility/claim paths.
# ENABLED=1 attaches runtime network decision + trace metadata using provider NPI and resolved canonical payor.
# SHADOW=1 computes and reports decision without rollout gating side-effects.
# PROVIDER_NETWORK_PRECHECK_ENABLED=0
# PROVIDER_NETWORK_PRECHECK_SHADOW=0
# When enabled: empty provider_payer_networks table → decision unknown, reason no_network_data (not network_link_not_found).

# --- Patient web checkout idempotency ---
# POST /api/patient/appointments/:id/checkout honors Idempotency-Key (operation patient_checkout) to prevent duplicate Stripe sessions.

# --- Semantic code search (requires code_embeddings populated) ---
# SEMANTIC_SEARCH_ENABLED=true
# USE_SEMANTIC_SEARCH=true

# --- Stedi (test mode: test_ API key + STEDI_TEST_MODE=1) ---
# STEDI_API_KEY=
# STEDI_API_BASE=https://core.us.stedi.com
# STEDI_HEALTHCARE_BASE=https://healthcare.us.stedi.com
# STEDI_TEST_MODE=1
# STEDI_TEST_PAYER_ID=STEDI
# STEDI_TEST_MEMBER_ID=0000000001
# STEDI_TEST_PROVIDER_NPI=1999999984
# STEDI_CLAIM_SUBMISSION_MODE=professional
# STEDI_USE_PROFESSIONAL_CLAIMS=1
# STEDI_WEBHOOK_SECRET=

# --- Pinecone / Colab RAG (rotate PINECONE_API_KEY in console if key was shared) ---
# RAG_CPT_FALLBACK_PINECONE=1
# PINECONE_API_KEY=
# PINECONE_INDEX_HOST=doctorlittle-xxx.svc.xxx.pinecone.io
# PINECONE_NAMESPACE=
# COLAB_RAG_URL=https://medical-rag-api-xxx.onrender.com
# RAG_API_URL=disabled
# REMOTE_RAG_TIMEOUT_MS=2000
# RAG_TIMEOUT=10000
# EVAL_USE_SEMANTIC=false
# EMBEDDING_PROVIDER=openai
# VECTOR_SEARCH_BACKEND=pinecone

# --- Medical codebooks (run after placing CMS files under Knowledge/) ---
# node scripts/import-icd10-codes.js && node scripts/import-cpt-codes.js && node scripts/import-hcpcs-codes.js
# node scripts/populate-code-embeddings.js

# --- Dev / harness: GET /health?show_db_path=1 returns database_path for SQLite compare ---

# --- Stripe webhooks ---
# Production: point Stripe Dashboard to POST /webhooks/stripe (raw body; see server.js mount).
# Legacy duplicate endpoint POST /webhook/stripe is disabled unless ALLOW_LEGACY_STRIPE_WEBHOOK=1.
# STRIPE_WEBHOOK_SECRET=
# STRIPE_WEBHOOK_REPLAY_WINDOW_SEC=600
# ALLOW_LEGACY_STRIPE_WEBHOOK=0

# --- Twilio webhook security (recommended in production) ---
# Enforce X-Twilio-Signature validation on /voice/incoming, /sms/incoming, /voice/status-callback.
# Default behavior: ON in production unless explicitly set to 0/false.
# TWILIO_WEBHOOK_SIGNATURE_REQUIRED=1

# --- Provider SIM trial signup (see docs/deployment/PROVIDER_SIGNUP_FLOW.md) ---
# TRIAL_SIM_FLOW_ENABLED=1
# TRIAL_SIM_LAUNCH_AT=2026-05-28T00:00:00Z
# Fallback area code when mobile is invalid (e.g. +1555…) or no inventory in preferred NPA
# TRIAL_DEFAULT_AREA_CODE=202
# TWILIO_VERIFY_SERVICE_SID=VAxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxx
# Local smoke without real SMS: TWILIO_VERIFY_DEV_MOCK=1 (restart server; OTP 000000 on verify-phone/check)
# E2E / smoke: TRIAL_E2E_PHONE=+12025551234  TRIAL_E2E_LIVE_TWILIO=1 (optional, purchases number)

# --- Circle webhook replay defense ---
# Reject stale Circle webhook events older than this many seconds.
# CIRCLE_WEBHOOK_REPLAY_WINDOW_SEC=900

# --- Fraud review SLA monitor ---
# Poll interval and batch size for alerting overdue fraud review queue items.
# FRAUD_REVIEW_SLA_ALERT_INTERVAL_MS=60000
# FRAUD_REVIEW_SLA_ALERT_BATCH=50

# --- Public catalog / commerce rate limits (separate from global /api limiter) ---
# GET /api/public/products|prescriptions and legacy /public/* aliases use PUBLIC_CATALOG_RATE_MAX per 15 min per IP.
# PUBLIC_CATALOG_RATE_MAX=1200
# /api/public/commerce/* (quote, cart, etc.) uses PUBLIC_COMMERCE_RATE_MAX per 15 min per IP.
# PUBLIC_COMMERCE_RATE_MAX=400
# Optional: when subdomain + DB default merchant are missing, public commerce/catalog can fall back to this merchant UUID.
# PUBLIC_CATALOG_DEFAULT_PROVIDER_ID=

# --- Agentic commerce / checkout ---
# Optional: POST JSON alerts for external API failures, missing merchant, or createOrder errors (audit_events always recorded).
# COMMERCE_ALERT_WEBHOOK_URL=
# When 1, PaymentOrchestrator does not create merchant_orders on sync PI success — rely on Stripe webhook only.
# COMMERCE_ORDER_FROM_WEBHOOK_ONLY=0

# --- Catalog master sync (OBF -> local search index) ---
# Enable periodic OBF sync worker (GCS-backed baseline + deltas).
# CATALOG_MASTER_SYNC_ENABLED=1
# CATALOG_MASTER_SYNC_INTERVAL_MS=86400000
# CATALOG_MASTER_BOOTSTRAP_BASELINE_ON_EMPTY=1
# OBF_GCS_PREFIX=gs://skinandcare-media-staging/obf
