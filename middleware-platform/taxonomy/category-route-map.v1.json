  "conflict_policy": {
    "catalog_tie_break": "prefer_source_specific_route_then_precedence",
    "notes": [
      "When OBF and OFF disagree, use catalog-specific route if endpoint is catalog-specific.",
      "When merged context is required, evaluate all matched routes then pick the highest precedence route.",
      "A route change must include change_reason and map_version."
    ]
  },
  "heuristics": {
    "low_confidence_policy": {
      "queue_when": [
        "route_unknown",
        "confidence_low"
      ],
      "fallback_copy": {
        "unknown": "We could not confidently classify this product yet. You can still continue with ingredient-based analysis.",
        "low_confidence": "This category is a low-confidence estimate and may be adjusted after review."
      }
    },
    "negative_signals": {
      "top_ingredients_n": 3,
      "strong_food_tokens": [
        "flour",
        "sugar",
        "salt",
        "wheat",
        "corn syrup"
      ],
      "weak_food_tokens": [
        "milk",
        "butter",
        "cocoa",
        "rice",
        "oat",
        "soy"
      ],
      "requires_weak_token_count": 2
    },
    "positive_signals": {
      "title_or_brand": [
        {
          "pattern": "\\b(spf|sunscreen|sunblock)\\b",
          "route": "cosmetic",
          "rule_id": "title_spf"
        },
        {
          "pattern": "\\b(shampoo|conditioner|body wash|toothpaste)\\b",
          "route": "hygiene",
          "rule_id": "title_hygiene"
        },
        {
          "pattern": "\\b(vitamin|probiotic|supplement|protein powder)\\b",
          "route": "supplement",
          "rule_id": "title_supplement"
        }
      ],
      "regulatory_drug_adjacent": [
        {
          "pattern": "\\bdrug facts\\b",
          "route": "non_food",
          "rule_id": "drug_facts"
        },
        {
          "pattern": "\\bover-the-counter|otc\\b",
          "route": "non_food",
          "rule_id": "otc_signal"
        }
      ],
      "ingredient_substrings": [
        {
          "pattern": "\\bretinol|adapalene|benzoyl peroxide|salicylic acid\\b",
          "route": "non_food",
          "rule_id": "ingredient_drug_adjacent"
        },
        {
          "pattern": "\\bfragrance|parfum|perfume\\b",
          "route": "cosmetic",
          "rule_id": "ingredient_cosmetic"
        }
      ]
    }
  }
}
