# Staging Cloud Run — non-secret env SSOT (copy to Secret Manager for secrets).
# See docs/deployment/STAGING_TRIAL_ROLLOUT.md and docs/Database/ENV_AND_DB_SSOT.md

NODE_ENV=production

# URLs
API_BASE_URL=https://api.callsomo.com
BASE_URL=https://api.callsomo.com
PUBLIC_BASE_URL=https://api.callsomo.com

# SQLite (primary until Postgres read flip) + GCS durability
DB_PATH=/var/data/middleware-staging.db
GCS_DB_BUCKET=somo-staging-db-somo-callsomo
GCS_DB_OBJECT=middleware-staging.db
SKIP_STARTUP_MIGRATIONS=0
MIGRATIONS_STRICT=1

# Cloud SQL mirror (set POSTGRES_URL via Secret Manager)
# POSTGRES_URL=postgresql://user:pass@/somo_staging?host=/cloudsql/PROJECT:REGION:somo-staging-pg
KELLY_RAILS_SSOT_POSTGRES=1
POSTGRES_PRIMARY=1
GCS_DB_UPLOAD_INTERVAL_MS=300000

# Trial
TRIAL_SIM_FLOW_ENABLED=1
TRIAL_DEFAULT_AREA_CODE=363
# TRIAL_SIM_LAUNCH_AT=2026-06-01T00:00:00Z

# Owner (password in Secret Manager: somo-staging-somo-owner-password)
SOMO_OWNER_EMAIL=richard@callsomo.com
SOMO_OWNER_NAME=Somo Owner
SOMO_OWNER_CLINIC_NAME=Somo Clinic

# Voice (secrets in Secret Manager)
# TWILIO_ACCOUNT_SID=
# TWILIO_AUTH_TOKEN=
# RETELL_API_KEY=
# RETELL_AGENT_ID=
RETELL_LLM_WEBSOCKET_URL=wss://api.callsomo.com/webhook/retell/llm
USE_TRIAGE_RAG_V2=1
RAG_API_URL=disabled
RAG_CPT_FALLBACK_PINECONE=1
PINECONE_INDEX_HOST=doctorlittle-lec5o4u.svc.aped-4627-b74a.pinecone.io
REMOTE_RAG_TIMEOUT_MS=8000
PINECONE_MIN_SCORE=0.42
EVAL_USE_SEMANTIC=false
TRIAGE_HYDE_ENABLED=1
# OPQRST Field Gate — default on; set 0 only for legacy rollback
OPQRST_FIELD_GATE_ENABLED=1

# Billing (Stripe test mode — secrets in Secret Manager)
# STRIPE_SECRET_KEY=sk_test_...
# STRIPE_PUBLISHABLE_KEY=pk_test_...

# Security flags
REQUIRE_JWT_FOR_FHIR=1
REQUIRE_TRIAGE_FOR_VOICE=1
CLOUDRUN_BOOT_DEBUG=0

# Email (SMTP on GCP — password in Secret Manager: somo-smtp-password)
EMAIL_PROVIDER=smtp
SMTP_HOST=smtp.gmail.com
SMTP_PORT=587
SMTP_USER=richard@callsomo.com
SMTP_FROM=Somo <richard@callsomo.com>

# Optional bootstrap attach (Cloud Run Job only — not service env)
# STAGING_OWNER_TWILIO_PHONE=+13639990205
# STAGING_OWNER_TWILIO_SID=PNxxxxxxxx
# STAGING_SKIP_RETELL_CONFIGURE=0
