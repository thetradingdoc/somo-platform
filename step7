def _preview_one_line(text: str, max_len: int = 140) -> str:
    t = (text or '').replace('\n', ' ').strip()
    if len(t) <= max_len:
        return t
    return t[: max_len - 1] + '…'


def print_deep_retrieval_analysis(result: RetrievalResult, label: str, *, max_expanded_chars: int = 480) -> None:
    """
    Print retrieval diagnostics beyond the one-line summary:
    expanded query, full pipeline trace, cosine/rerank distribution, top-k table,
    source diversity, optional graph context count.
    """
    s = result.scores
    print('  ── Deep analysis ─────────────────────────────────────────────')
    print(f"  Expectation (label): {label}")
    print(f"  Wall time: {result.elapsed_ms:.0f} ms")

    if s.vague_query:
        print('  Vague-query guard: no embedding / no Pinecone (by design).')
        print('  Full trace:')
        for i, step in enumerate(result.pipeline_trace, 1):
            print(f"    {i:2d}. {step}")
        print('  → VAGUE QUERY CAUGHT ✅')
        return

    eq = result.expanded_query
    shown = eq if len(eq) <= max_expanded_chars else (eq[: max_expanded_chars - 1] + '…')
    print(f"  Expanded query ({len(result.expanded_query)} chars):")
    print(f"    {shown}")

    print('  Flags: '
          f"HyDE={'✅' if s.hyde_used else '—'} | "
          f"expanded={'✅' if s.synonym_expanded else '—'} | "
          f"concept={'✅' if s.concept_filter_used else '—'} | "
          f"fallback={'✅' if s.recall_fallback_used else '—'} | "
          f"reranker={'✅' if s.reranker_used else '—'}")

    print('  Pipeline trace:')
    for i, step in enumerate(result.pipeline_trace, 1):
        print(f"    {i:2d}. {step}")

    chunks = result.chunks
    if not chunks:
        print('  (No chunks returned.)')
        return

    cos_vals = [c.score for c in chunks]
    rr_vals = [c.rerank_score for c in chunks if c.rerank_score is not None]

    print(f"  Distribution (n={len(chunks)}): "
          f"cosine min/mean/max = {min(cos_vals):.4f} / "
          f"{sum(cos_vals)/len(cos_vals):.4f} / {max(cos_vals):.4f}")
    if rr_vals:
        print(f"                      rerank min/mean/max = {min(rr_vals):.4f} / "
              f"{sum(rr_vals)/len(rr_vals):.4f} / {max(rr_vals):.4f}")
        if len(rr_vals) >= 2:
            k = min(5, len(rr_vals))
            spread = rr_vals[0] - rr_vals[k - 1]
            print(f"                      rerank top1 − top{k} = {spread:.4f} "
                  '(larger ⇒ steeper ranking)')

    top5_names = [c.source_file for c in chunks[:5]]
    print(f"  Source diversity (top-5): {len(set(top5_names))} unique file(s)")

    if result.context_chunks:
        print(f"  Graph expansion: +{len(result.context_chunks)} context chunk(s) "
              '(siblings/parents)')

    top = chunks[0]
    ent = top.entities or {}
    ent_bits = []
    for key in ('conditions', 'drugs', 'clinical_scores'):
        v = ent.get(key) or []
        if v:
            ent_bits.append(f"{key}={len(v)}")
    if ent_bits:
        print(f"  Top-1 extracted entities: {', '.join(ent_bits)}")

    print(f"  Top-1 preview: {_preview_one_line(top.text, 220)}")
    print()
    print(f"  {'#':>2}  {'cosine':>8}  {'rerank':>10}  {'specialty':<22}  source")
    print('  ' + '─' * 72)
    for i, c in enumerate(chunks, 1):
        rr = f"{c.rerank_score:10.4f}" if c.rerank_score is not None else '—'.rjust(10)
        sp = ', '.join((c.specialty or [])[:2])[:20] or '—'
        src = (c.source_file or '?')[:28]
        print(f"  {i:2d}  {c.score:8.4f}  {rr}  {sp:<22}  {src}")

    print('  ────────────────────────────────────────────────────────────────')


def print_compact_retrieval_line(result: RetrievalResult) -> None:
    """Original one-line + top-1 snippet (used when STEP7_DEEP_SELF_TEST=0)."""
    s = result.scores
    top = result.chunks[0] if result.chunks else None
    print(f"  Chunks: {s.n_final} | cosine={s.top1_cosine:.3f} | "
          f"rerank={(f'{s.top1_rerank:.3f}' if s.top1_rerank is not None else 'N/A')} | "
          f"HyDE={'✅' if s.hyde_used else '—'} | "
          f"expanded={'✅' if s.synonym_expanded else '—'} | "
          f"concept={'✅' if s.concept_filter_used else '—'} | "
          f"fallback={'✅' if s.recall_fallback_used else '—'}")
    if s.vague_query:
        print('  → VAGUE QUERY CAUGHT ✅')
    elif top:
        print(f"  Top-1: {top.source_file[:50]}")
        print(f"         {top.text[:100]}…")
    print(f"  Trace : {' → '.join(result.pipeline_trace[:4])}")


