def expand_synonyms(query: str) -> tuple:
    """
    Expand informal/abbreviated terms to clinical equivalents.
    Returns (expanded_query, was_expanded).
    """
    q_lower = query.lower().strip()

    # Exact match
    if q_lower in SYNONYM_MAP:
        expanded = f"{query} {SYNONYM_MAP[q_lower]}"
        return expanded, True

    # Partial match — find all synonym keys present in the query
    added_terms = []
    for key, expansion in SYNONYM_MAP.items():
        if key in q_lower and len(key) >= 3:
            added_terms.append(expansion)

    if added_terms:
        expanded = query + ' ' + ' '.join(added_terms)
        return expanded, True

    return query, False


