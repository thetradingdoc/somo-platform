def detect_concepts(query: str) -> List[str]:
    """Returns FEA concept IDs matched in this query."""
    q = query.lower()
    found = set()
    for phrase, concept_ids in QUERY_CONCEPT_MAP.items():
        if phrase in q:
            found.update(concept_ids)
    return list(found)


