    Upload this file to /content/ and the Patient RAG Pipeline will import it
    automatically via the bootstrap in step7a_patient_pipeline_v3.2.py.
    """

    CHUNK_PREFIX = 'v4_chunk_'

    def __init__(
        self,
        openai_api_key:   str = None,
        pinecone_api_key: str = None,
        pinecone_index:   str = 'doctorlittle',
        embed_model:      str = 'text-embedding-3-small',
        top_k:            int = 10,
        score_threshold:  float = 0.50,
        use_hyde:         bool = True,
        use_reranker:     bool = True,
        use_diversity:    bool = True,
        use_graph:        bool = True,
        verbose:          bool = False,
    ):
        openai_key   = openai_api_key   or os.getenv('OPENAI_API_KEY')
        pinecone_key = pinecone_api_key or os.getenv('PINECONE_API_KEY')

        if not openai_key:
            raise ValueError("Set OPENAI_API_KEY env var")
        if not pinecone_key:
            raise ValueError("Set PINECONE_API_KEY env var")

        self._openai       = OpenAI(api_key=openai_key)
        pc                 = Pinecone(api_key=pinecone_key)
        self._index        = pc.Index(pinecone_index)
        self._embed_model  = embed_model
        self._top_k        = top_k
        self._threshold    = score_threshold
        self._use_hyde     = use_hyde
        self._use_reranker = use_reranker and _HAS_RERANKER
        self._use_diversity= use_diversity
        self._use_graph    = use_graph
        self._verbose      = verbose
        self._reranker     = None

        if self._use_reranker:
            try:
                self._reranker = CrossEncoder(
                    'cross-encoder/ms-marco-MiniLM-L-6-v2', max_length=512
                )
                if verbose:
                    print("✅  Cross-encoder loaded")
            except Exception as e:
                print(f"⚠  Cross-encoder failed to load: {e}")
                self._use_reranker = False

        stats = self._index.describe_index_stats()
        if verbose:
            print(f"✅  ClinicalQueryEngine ready | {stats.total_vector_count:,} vectors")

    # ── INTERNAL HELPERS ──────────────────────────────────────────────────────

    def _embed(self, text: str) -> List[float]:
        r = self._openai.embeddings.create(
            model=self._embed_model, input=text[:6000]
        )
        return r.data[0].embedding

    def _blend(self, v1: List[float], v2: List[float],
               w1: float = 0.45, w2: float = 0.55) -> List[float]:
        b = [w1 * a + w2 * b for a, b in zip(v1, v2)]
        n = sum(x * x for x in b) ** 0.5
        return [x / n for x in b] if n > 1e-9 else b

    def _hyde(self, question: str) -> Optional[str]:
        if not self._use_hyde:
            return None
        try:
            r = self._openai.chat.completions.create(
                model='gpt-4o-mini',
                messages=[
                    {'role': 'system', 'content': _HYDE_SYSTEM},
                    {'role': 'user',   'content': question},
                ],
                max_tokens=220, temperature=0.2,
            )
            return r.choices[0].message.content.strip()
        except Exception:
            return None

    def _pc_query(
        self,
        vector:      List[float],
        top_k:       int = 40,
        filter_dict: Optional[Dict] = None,
    ) -> List[Dict]:
        kw = {'vector': vector, 'top_k': top_k, 'include_metadata': True}
        if filter_dict:
            kw['filter'] = filter_dict
        try:
            matches = self._index.query(**kw).matches
        except Exception as e:
            if self._verbose:
                print(f"  Pinecone error: {e}")
            return []
        return [
            {
                'id':       m.id,
                'score':    float(m.score),
                'metadata': m.metadata or {},
                'rerank_score': None,
            }
            for m in matches
            if m.id.startswith(self.CHUNK_PREFIX)
        ]

    def _rerank(self, question: str, candidates: List[Dict]) -> List[Dict]:
        """Pure rerank sort — no cosine blend. FIX 5."""
        if not self._use_reranker or not self._reranker or not candidates:
            return candidates

        pairs = [
            (question, c['metadata'].get('text', '')[:400])
            for c in candidates[:50]
        ]
        try:
            scores = self._reranker.predict(pairs, show_progress_bar=False)
            min_sc = float(min(scores)) if len(scores) > 0 else -999.0
            for i, c in enumerate(candidates):
                if i < len(scores):
                    c['rerank_score'] = float(scores[i])
                else:
                    c['rerank_score'] = min_sc - 1.0
            # Pure sort by rerank score — no cosine blend
            candidates.sort(
                key=lambda x: x['rerank_score'] if x['rerank_score'] is not None
                              else x['score'],
                reverse=True,
            )
        except Exception as e:
            if self._verbose:
                print(f"  Reranker error: {e}")
        return candidates

    def _fetch_context_chunks(self, chunks: List[Dict]) -> List[Dict]:
        """Fetch parent + sibling chunks for graph expansion. FIX uses graph_node_id."""
        if not self._use_graph or not chunks:
            return []
        related_ids = set()
        for c in chunks[:5]:
            m = c['metadata']
            parent = m.get('parent_node_id', '')
            if parent and parent.startswith(self.CHUNK_PREFIX):
                related_ids.add(parent)
            for sib in (m.get('sibling_node_ids') or [])[:2]:
                if sib and sib.startswith(self.CHUNK_PREFIX):
                    related_ids.add(sib)
        # Remove IDs already in top results
        top_ids = {c['id'] for c in chunks}
        fetch_ids = list(related_ids - top_ids)[:8]
        if not fetch_ids:
            return []
        try:
            result = self._index.fetch(ids=fetch_ids)
            return [
                {
                    'id':       vid,
                    'score':    0.0,
                    'metadata': v.metadata or {},
                    'rerank_score': None,
                }
                for vid, v in result.vectors.items()
            ]
        except Exception:
            return []

    def _to_chunk(self, c: Dict, hyde_used: bool, reranker_used: bool) -> RetrievalChunk:
        m  = c['metadata']
        sp = m.get('specialty', [])
        if not isinstance(sp, list):
            sp = [sp] if sp else []
        cids = m.get('concept_ids', [])
        if not isinstance(cids, list):
            cids = []
        return RetrievalChunk(
            chunk_id      = c['id'],
            score         = c.get('score', 0.0),
            rerank_score  = c.get('rerank_score'),
            text          = m.get('text', '')[:800],
            source_file   = m.get('source_file', ''),
            section_path  = m.get('section_path', ''),
            specialty     = sp,
            concept_ids   = cids,
            semantic_type = m.get('semantic_type', ''),
            quality_tier  = m.get('quality_tier', ''),
            entities      = {
                'conditions':      m.get('entities_conditions',         []),
                'drugs':           m.get('entities_drugs',              []),
                'lab_values':      m.get('entities_lab_values',         []),
                'procedures':      m.get('entities_procedures',         []),
                'clinical_scores': m.get('entities_clinical_scores_l3', []),
            },
            hyde_used     = hyde_used,
            reranker_used = reranker_used,
        )

    # ── MAIN QUERY METHOD ─────────────────────────────────────────────────────

    def query(
        self,
        question:         str,
        specialty_filter: Optional[str] = None,
        concept_filter:   Optional[List[str]] = None,
        semtype_filter:   Optional[str] = None,
    ) -> RetrievalResult:
        """
        Execute the 7-layer clinical query pipeline.

        Args:
            question:         Raw user query (any format, any language)
            specialty_filter: Override detected specialty (e.g. 'dermatology')
            concept_filter:   Override concept IDs for FEA filtered retrieval
            semtype_filter:   Restrict to a semantic type (e.g. 'dosing')

        Returns:
            RetrievalResult dataclass (compatible with _engine_query_to_chunks)
        """
        t0    = time.time()
        trace = []

        # ── LAYER 0: Vague query guard ─────────────────────────────────────
        if is_vague_query(question):
            trace.append(f"VAGUE: '{question}' — returning empty result")
            return RetrievalResult(
                query          = question,
                expanded_query = question,
                chunks         = [],
                context_chunks = [],
                scores         = RetrievalScores(
                    top1_cosine=0.0, top1_rerank=None,
                    hyde_used=False, reranker_used=False,
                    n_final=0, vague_query=True,
                ),
                pipeline_trace = trace,
                elapsed_ms     = (time.time() - t0) * 1000,
            )

        # ── LAYER 1: Synonym expansion ─────────────────────────────────────
        expanded_query, was_expanded = expand_synonyms(question)
        if was_expanded:
            trace.append(f"SYNONYM: '{question}' → expanded ({len(expanded_query)} chars)")
        else:
            trace.append(f"QUERY: '{question}' (no expansion)")

        # ── LAYER 2: Specialty routing ─────────────────────────────────────
        auto_specialty = specialty_filter or detect_specialty(expanded_query)
        base_filter: Dict = {'quality_tier': {'$in': ['high', 'medium']}}
        if auto_specialty:
            base_filter['specialty'] = {'$in': [auto_specialty]}
            trace.append(f"SPECIALTY: {auto_specialty}")
        else:
            trace.append("SPECIALTY: none (general)")

        if semtype_filter:
            base_filter['semantic_type'] = {'$eq': semtype_filter}

        # ── LAYER 3: HyDE generation ───────────────────────────────────────
        raw_vec   = self._embed(expanded_query)
        hyde_text = self._hyde(question)
        hyde_vec  = None
        if hyde_text:
            hyde_vec = self._embed(hyde_text)
            trace.append(f"HYDE: generated ({len(hyde_text)} chars)")
        else:
            trace.append("HYDE: skipped")

        # ── LAYER 4: Pinecone retrieval ────────────────────────────────────
        # Pass A: raw query vector
        cands_raw = self._pc_query(raw_vec, top_k=40, filter_dict=base_filter)
        trace.append(f"RAW: {len(cands_raw)} candidates")

        # Pass B: HyDE blended vector
        cands_hyde = []
        if hyde_vec is not None:
            blended    = self._blend(raw_vec, hyde_vec)
            cands_hyde = self._pc_query(blended, top_k=40, filter_dict=base_filter)
            trace.append(f"HYDE_RETRIEVE: {len(cands_hyde)} candidates")

        # Pass C: Concept-filtered retrieval (FIX 6)
        cands_concept = []
        concept_used  = False
        auto_concepts = concept_filter or detect_concepts(expanded_query)
        if auto_concepts:
            concept_filter_dict = dict(base_filter)
            concept_filter_dict['concept_ids'] = {'$in': auto_concepts}
            cands_concept = self._pc_query(raw_vec, top_k=20,
                                           filter_dict=concept_filter_dict)
            trace.append(f"CONCEPT ({auto_concepts[:2]}): {len(cands_concept)} candidates")
            concept_used = bool(cands_concept)

        # Merge all passes — keep max score per chunk ID
        seen: Dict[str, Dict] = {}
        for lst in [cands_raw, cands_hyde, cands_concept]:
            for c in lst:
                cid = c['id']
                if cid not in seen or c['score'] > seen[cid]['score']:
                    seen[cid] = c
        merged = sorted(seen.values(), key=lambda x: x['score'], reverse=True)

        # ── LAYER 5: Recall fallback (FIX 4) ──────────────────────────────
        recall_fallback = False
        above_thresh    = [c for c in merged if c['score'] >= self._threshold]
        if len(above_thresh) < 2 and auto_specialty:
            trace.append(f"FALLBACK: only {len(above_thresh)} above threshold — "
                         f"retrying without specialty filter")
            broad_filter  = {'quality_tier': {'$in': ['high', 'medium']}}
            cands_broad   = self._pc_query(raw_vec, top_k=40,
                                           filter_dict=broad_filter)
            for c in cands_broad:
                cid = c['id']
                if cid not in seen or c['score'] > seen[cid]['score']:
                    seen[cid] = c
            merged          = sorted(seen.values(), key=lambda x: x['score'], reverse=True)
            recall_fallback = True
            trace.append(f"FALLBACK: now {len(merged)} candidates")

        # ── LAYER 6: Rerank (FIX 5 — pure sort) ───────────────────────────
        merged = self._rerank(question, merged)
        final  = merged[:self._top_k]
        trace.append(f"FINAL: {len(final)} chunks after rerank")

        # ── LAYER 7: Graph expansion ───────────────────────────────────────
        context_raw    = self._fetch_context_chunks(final) if self._use_graph else []
        context_chunks = [
            self._to_chunk(c, hyde_used=False, reranker_used=False)
            for c in context_raw
        ]

        # ── Build result ───────────────────────────────────────────────────
        hyde_used_flag    = hyde_vec is not None
        reranker_used_flag= self._use_reranker and self._reranker is not None

        chunks = [
            self._to_chunk(c, hyde_used=hyde_used_flag,
                           reranker_used=reranker_used_flag)
            for c in final
        ]

        top1 = final[0] if final else {}
        scores = RetrievalScores(
            top1_cosine          = top1.get('score', 0.0),
            top1_rerank          = top1.get('rerank_score'),
            hyde_used            = hyde_used_flag,
            reranker_used        = reranker_used_flag,
            n_final              = len(chunks),
            recall_fallback_used = recall_fallback,
            concept_filter_used  = concept_used,
            synonym_expanded     = was_expanded,
            vague_query          = False,
        )

        elapsed = (time.time() - t0) * 1000

        if self._verbose:
            print(f"  [{elapsed:.0f}ms] {len(chunks)} chunks | "
                  f"cosine={scores.top1_cosine:.3f} | "
                  f"rerank={(f'{scores.top1_rerank:.3f}' if scores.top1_rerank is not None else 'N/A')} | "
                  f"HyDE={'✅' if hyde_used_flag else '—'} | "
                  f"specialty={auto_specialty or 'none'}")

        return RetrievalResult(
            query          = question,
            expanded_query = expanded_query,
            chunks         = chunks,
            context_chunks = context_chunks,
            scores         = scores,
            pipeline_trace = trace,
            elapsed_ms     = elapsed,
        )


