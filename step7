def detect_specialty(query: str) -> Optional[str]:
    """
    Returns the most likely specialty for this query, or None for general.
    Used to build Pinecone metadata filter.
    """
    q = query.lower()
    words = set(re.findall(r'\b\w+\b', q))

    scores = {
        'dermatology':      sum(1 for s in _DERM_SIGNALS        if s in q),
        'hepatology':       sum(1 for s in _HEPATOLOGY_SIGNALS  if s in q),
        'cardiology':       sum(1 for s in _CARDIOLOGY_SIGNALS  if s in q),
        'nephrology':       sum(1 for s in _NEPHROLOGY_SIGNALS  if s in q),
        'neurology':        sum(1 for s in _NEUROLOGY_SIGNALS   if s in q),
        'endocrinology':    sum(1 for s in _ENDOCRINE_SIGNALS   if s in q),
        'infectious_disease': sum(1 for s in _INFECTIOUS_SIGNALS if s in q),
    }

    best_sp = max(scores, key=scores.get)
    best_sc = scores[best_sp]

    if best_sc == 0:
        return None  # no specialty signals — use no filter

    # Only apply filter if signal is clear (avoid false positives)
    if best_sc >= 1:
        return best_sp

    return None


