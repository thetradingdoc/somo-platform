def _engine_query_to_chunks(result):
    """Normalise full engine RetrievalResult or inline dict to flat chunk list."""
    if hasattr(result, 'chunks'):  # full ClinicalQueryEngine
        chunks     = result.chunks
        trace      = result.pipeline_trace
        elapsed_ms = result.elapsed_ms
        scores     = result.scores
        return [{
            'score':          c.score,
            'rerank_score':   c.rerank_score,
            'source_file':    c.source_file,
            'specialty':      c.specialty[0] if isinstance(c.specialty,list) and c.specialty
                              else str(c.specialty),
            'concept_ids':    c.concept_ids,
            'semantic_type':  c.semantic_type,
            'quality_tier':   c.quality_tier,
            'text':           c.text,
            'section_path':   c.section_path,
            'engine_mode':    _ENGINE_MODE,
            'pipeline_trace': trace,
            'elapsed_ms':     elapsed_ms,
            'hyde_used':      scores.hyde_used,
            'reranker_used':  scores.reranker_used,
        } for c in chunks]
    elif isinstance(result, dict) and 'chunks' in result:  # inline engine
        chunks     = result['chunks']
        trace      = result.get('pipeline_trace', [])
        elapsed_ms = result.get('elapsed_ms', 0)
        scores     = result.get('scores', {})
        return [{
            'score':          c.get('score', 0.0),
            'rerank_score':   c.get('rerank_score'),
            'source_file':    c.get('source_file', ''),
            'specialty':      (c.get('specialty') or [''])[0]
                              if isinstance(c.get('specialty'), list)
                              else str(c.get('specialty', '')),
            'concept_ids':    c.get('concept_ids', []),
            'semantic_type':  c.get('semantic_type', ''),
            'quality_tier':   c.get('quality_tier', ''),
            'text':           c.get('text', ''),
            'section_path':   c.get('section_path', ''),
            'engine_mode':    _ENGINE_MODE,
            'pipeline_trace': trace,
            'elapsed_ms':     elapsed_ms,
            'hyde_used':      scores.get('hyde_used', False),
            'reranker_used':  scores.get('reranker_used', False),
        } for c in chunks]
    return result if isinstance(result, list) else []


def layer5_rag_validation(hypotheses, signal_analysis):
    print("\n" + "─"*60)
    print("  LAYER 5 — RAG VALIDATION  (ClinicalQueryEngine — Step 7A)")
    print(f"  Engine: {_ENGINE_MODE}")
    print("─"*60)

    diff_list = hypotheses.get('differential_diagnoses', [])
    clusters  = signal_analysis.get('signal_clusters', [])
    evidence_by_differential = {}

    for d in diff_list:  # all 3 differentials
        name      = d.get('name', 'unknown')
        mechanism = d.get('mechanism', '')
        findings  = ', '.join(d.get('findings_explained', [])[:5])
        disc_test = d.get('key_discriminating_test', '')

        q_mechanism = (
            f"Pathophysiology and mechanism of {name}. "
            f"Biological cascade: {mechanism[:250]}. "
            f"Key abnormal findings: {findings}."
        )
        q_management = (
            f"{name} diagnosis criteria investigation management guidelines. "
            f"How to distinguish from similar conditions. "
            f"Key discriminating test: {disc_test}."
        )

        print(f"\n  🔍 [{name}]")
        evidence_by_differential[name] = {}

        for q_type, query in [('mechanism', q_mechanism),
                               ('management', q_management)]:
            try:
                raw    = _engine.query(query)
                chunks = _engine_query_to_chunks(raw)
            except Exception as e:
                print(f"     ⚠  Engine failed ({q_type}): {e} — fallback")
                chunks = _naive_retrieve(query, TOP_K)
            for c in chunks:
                c['query_type'] = q_type
            evidence_by_differential[name][q_type] = chunks

            top        = chunks[0] if chunks else {}
            rerank_str = (f"  rerank={top.get('rerank_score',0.0):.4f}"
                          if top.get('rerank_score') is not None else '')
            hyde_icon  = '✅' if top.get('hyde_used') else '—'
            print(f"     [{q_type:<12}] {len(chunks):>2} chunks | "
                  f"cosine={top.get('score',0.0):.4f}{rerank_str} | "
                  f"HyDE={hyde_icon} | "
                  f"src={str(top.get('source_file',''))[:35]}")

    # Cluster queries
    cluster_evidence = {}
    for cluster in clusters[:2]:
        cname   = cluster.get('cluster_name', '')
        signals = ', '.join(cluster.get('signals', []))
        pattern = cluster.get('pattern_description', '')
        query   = f"{cname}: {signals}. {pattern}"
        print(f"\n  🔍 [Cluster: {cname}]")
        try:
            raw    = _engine.query(query)
            chunks = _engine_query_to_chunks(raw)
        except Exception as e:
            print(f"     ⚠  Fallback: {e}")
            chunks = _naive_retrieve(query, 6)
        for c in chunks: c['query_type'] = 'cluster'
        cluster_evidence[cname] = chunks
        top        = chunks[0] if chunks else {}
        rerank_str = (f"  rerank={top.get('rerank_score',0.0):.4f}"
                      if top.get('rerank_score') is not None else '')
        print(f"     [cluster     ] {len(chunks):>2} chunks | "
              f"cosine={top.get('score',0.0):.4f}{rerank_str} | "
              f"src={str(top.get('source_file',''))[:35]}")

    total = sum(len(v.get('mechanism',[]))+len(v.get('management',[]))
                for v in evidence_by_differential.values()) + \
            sum(len(v) for v in cluster_evidence.values())

    print(f"\n  ✅ Layer 5: {total} evidence chunks | "
          f"{len(evidence_by_differential)} differentials × 2 queries + "
          f"{len(cluster_evidence)} cluster queries")

    return {
        'differential_evidence': evidence_by_differential,
        'cluster_evidence':      cluster_evidence,
        'engine_mode':           _ENGINE_MODE,
    }


