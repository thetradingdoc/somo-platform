def plot_lab_trends(df, save_dir=None):
    if df.empty: return
    df = df.copy()
    df['date'] = pd.to_datetime(df['date'])
    for test in sorted(df['test_name'].unique()):
        sub = df[df['test_name'] == test].sort_values('date')
        if sub.empty: continue
        fig, ax = plt.subplots(figsize=(8, 4))
        ax.plot(sub['date'], sub['value'], marker='o', linewidth=2, color='#2196F3')
        for _, row in sub.iterrows():
            colour = 'red' if str(row.get('flag','')).lower() in ('high','low','critical') else '#2196F3'
            ax.plot(row['date'], row['value'], 'o', color=colour, markersize=9)
        lo, hi = sub['normal_low'].iloc[0], sub['normal_high'].iloc[0]
        ax.fill_between(sub['date'], lo, hi, color='green', alpha=0.10, label='Normal range')
        ax.axhline(lo, color='red', linestyle='--', linewidth=1)
        ax.axhline(hi, color='red', linestyle='--', linewidth=1)
        unit = sub['unit'].iloc[0] if 'unit' in sub.columns else ''
        ax.set_title(f"{test} Over Time", fontsize=13, fontweight='bold')
        ax.set_xlabel("Date"); ax.set_ylabel(f"{test} ({unit})" if unit else test)
        ax.legend(); fig.autofmt_xdate()
        ax.grid(True, linestyle=':', alpha=0.5)
        fig.tight_layout()
        if save_dir:
            safe = re.sub(r'[^\w\-]', '_', test)
            fig.savefig(save_dir / f"trend_{safe}.png", dpi=120)
        plt.show(); plt.close(fig)


def build_lab_summary(df):
    if df.empty: return "No structured lab data extracted."
    lines = []
    df = df.copy()
    df['date'] = pd.to_datetime(df['date'])
    for test in sorted(df['test_name'].unique()):
        sub  = df[df['test_name'] == test].sort_values('date')
        lo   = sub['normal_low'].iloc[-1]
        hi   = sub['normal_high'].iloc[-1]
        unit = sub['unit'].iloc[-1] if 'unit' in sub.columns else ''
        u    = f" {unit}" if unit else ""
        flag = str(sub['flag'].iloc[-1]) if 'flag' in sub.columns else 'normal'
        mark = "  ⚠ ABNORMAL" if flag in ('high','low','critical') else ""
        if len(sub) >= 2:
            v0, v1 = sub['value'].iloc[0], sub['value'].iloc[-1]
            trend  = "↑" if v1 > v0 else ("↓" if v1 < v0 else "→")
            lines.append(f"- **{test}**: {v0}{u} → {v1}{u} (ref {lo}–{hi}{u}) {trend}{mark}")
        else:
            lines.append(f"- **{test}**: {sub['value'].iloc[-1]}{u} (ref {lo}–{hi}{u}){mark}")
    return "\n".join(lines)


def _colab_upload(dest_dir, label):
    try:
        from google.colab import files as colab_files
    except ImportError:
        print(f"  ⚠  Not in Colab — place files manually in:\n     {dest_dir}")
        return []
    print(f"\n  📎 Select {label}  (Ctrl/Cmd for multiple)")
    uploaded = colab_files.upload()
    saved = []
    for fname, data in uploaded.items():
        dst = dest_dir / fname
        dst.write_bytes(data)
        saved.append(dst)
        print(f"  💾 Saved → {dst}")
    if not saved: print("  ℹ  No files uploaded.")
    return saved


def save_reasoning_chain(base, layers):
    chain_path = base / f"reasoning_chain_{datetime.now().strftime('%Y%m%d_%H%M%S')}.json"
    serialisable = {}
    for k, v in layers.items():
        if isinstance(v, pd.DataFrame):
            serialisable[k] = v.to_dict(orient='records')
        else:
            serialisable[k] = v
    chain_path.write_text(json.dumps(serialisable, indent=2, default=str))
    print(f"  🔍 Reasoning chain saved → {chain_path}")
    return chain_path


