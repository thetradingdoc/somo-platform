        evidence_text += f"\n── Evidence for differential: '{diff_name}' ──\n"
        for q_type, chunks in qtype_dict.items():
            evidence_text += f"\n  [{q_type} query]\n"
            for i, c in enumerate(chunks[:5], 1):
                rerank_score  = c.get('rerank_score')
                rerank_str    = f"{rerank_score:.4f}" if rerank_score is not None else "N/A"
                hyde_str      = "HyDE ✅" if c.get('hyde_used') else "HyDE —"
                source        = c.get('source_file', 'Unknown source')
                # Clean up source name — strip path noise
                source_clean  = re.sub(r'\.(md|pdf|txt)$', '', source, flags=re.IGNORECASE)
                source_clean  = re.sub(r'^\d{4,}', '', source_clean).strip(' -_')
                section       = c.get('section_path', '')
                specialty     = c.get('specialty', '')
                quality       = c.get('quality_tier', '')
                excerpt       = c.get('text', '')[:120].replace('\n', ' ')

                evidence_text += (
                    f"    [REF {ref_num}] {source_clean}\n"
                    f"            Section    : {section[:60] if section else '—'}\n"
                    f"            Specialty  : {specialty} | Quality: {quality}\n"
                    f"            Retrieval  : cosine={c.get('score',0.0):.4f} | "
                    f"rerank={rerank_str} | {hyde_str}\n"
                    f"            Supports   : {diff_name} ({q_type})\n"
                    f"            Excerpt    : \"{excerpt}...\"\n\n"
                )
                ref_map[(diff_name, q_type, i)] = ref_num
                ref_num += 1

    for cluster_name, chunks in rag_evidence.get('cluster_evidence', {}).items():
        evidence_text += f"\n── Cluster evidence: '{cluster_name}' ──\n"
        for i, c in enumerate(chunks[:3], 1):
            rerank_score = c.get('rerank_score')
            rerank_str   = f"{rerank_score:.4f}" if rerank_score is not None else "N/A"
            hyde_str     = "HyDE ✅" if c.get('hyde_used') else "HyDE —"
            source_clean = re.sub(r'\.(md|pdf|txt)$', '', c.get('source_file',''), flags=re.IGNORECASE)
            excerpt      = c.get('text','')[:120].replace('\n',' ')
            evidence_text += (
                f"    [REF {ref_num}] {source_clean}\n"
                f"            Retrieval  : cosine={c.get('score',0.0):.4f} | "
                f"rerank={rerank_str} | {hyde_str}\n"
                f"            Supports   : cluster pattern ({cluster_name})\n"
                f"            Excerpt    : \"{excerpt}...\"\n\n"
            )
            ref_num += 1

    # ── Build doc summary text ─────────────────────────────────────────────────
    doc_text = "\n".join([
        f"- {d['filename']}: {d['type']}"
        + (f" ({d['lab_count']} labs, {d['date']})" if d.get('lab_count') else "")
        + (" | imaging: YES" if d.get('has_imaging') else "")
        + (f" | notes: {d['notes'][:100]}" if d.get('notes') else "")
        for d in doc_summaries
    ])

    diff_list   = hypotheses.get('differential_diagnoses', [])
    alc_caveat  = hypotheses.get('alcohol_history_caveat', '')
    crit_unk    = hypotheses.get('critical_unknown', '')
    min_workup  = hypotheses.get('minimum_workup_before_diagnosis', [])
    ratio_data  = hypotheses.get('ratio_analysis', {})

    imaging_notes = ""
    for d in doc_summaries:
        if d.get('has_imaging') and d.get('notes'):
            imaging_notes += f"- {d['filename']}: {d['notes']}\n"
    if all_imaging:
        imaging_notes += f"\nFULL IMAGING TEXT:\n{all_imaging[:2000]}"

    user_prompt = (
        f"## PATIENT\n{patient_info}\n\n"
        f"## DOCUMENTS\n{doc_text}\n\n"
        f"## LAB SUMMARY\n{lab_summary}\n\n"
        f"## KEY RATIOS\n"
        f"AST:ALT = {ratio_data.get('AST_ALT_ratio','?')} — {ratio_data.get('ratio_implication','')}\n"
        f"NLR = {ratio_data.get('NLR','?')} — {ratio_data.get('NLR_implication','')}\n\n"
        f"## SIGNAL ANALYSIS\n{json.dumps(signal_analysis, indent=2)[:4000]}\n\n"
        f"## VISUAL FUSION\n{json.dumps(visual_fusion, indent=2)[:2500]}\n\n"
        f"## TOP 3 DIFFERENTIAL DIAGNOSES\n{json.dumps(diff_list, indent=2)[:3500]}\n\n"
        f"## ALCOHOL CAVEAT\n{alc_caveat}\n\n"
        f"## CRITICAL UNKNOWN\n{crit_unk}\n\n"
        f"## MINIMUM WORKUP BEFORE DIAGNOSIS\n"
        + "\n".join(f"- {w}" for w in min_workup) + "\n\n"
        f"## IMAGING FINDINGS\n{imaging_notes or 'See doc summaries above'}\n\n"
        f"## EVIDENCE REFERENCES (formatted for Section 10)\n{evidence_text[:4000]}\n\n"
        "MANDATORY CHECKS:\n"
        "✅ Section 5 opens with the ⚠️ caveat box — verbatim\n"
        "✅ Section 8 names BOTH critical unknowns: alcohol history AND prolactin MRI\n"
        "✅ Section 9 lists: prostatomegaly, renal calculus, fatty liver, cardiac findings\n"
        "✅ Section 10 uses the REF citation format with all fields populated\n"
        "✅ Section 10 ends with the rerank score interpretation footnote\n"
        "✅ No differential is called a confirmed diagnosis\n"
        "Write the complete clinical audit report now."
    )

    print("  🤖 Generating final report...")
    t0     = time.perf_counter()
    report = gpt4o(system=_L6_SYSTEM, user=user_prompt, temperature=0.2, max_tokens=6000)
    print(f"  ✅ Report generated in {time.perf_counter()-t0:.1f}s")
    return report


