def _bootstrap_engine():
    global _engine, _ENGINE_MODE

    try:
        _here = Path(__file__).resolve().parent
    except NameError:
        _here = Path.cwd()
    for p in ('/content', '/content/drive/MyDrive', str(_here), '.'):
        if p not in sys.path:
            sys.path.insert(0, p)

    _verbose = os.environ.get('STEP7_VERBOSE', '').strip().lower() in ('1', 'true', 'yes')
    _kw = dict(
        top_k=TOP_K,
        use_hyde=True,
        use_reranker=True,
        use_diversity=True,
        use_graph=True,
        verbose=_verbose,
    )

    # Attempt 1: Colab convention — step7a.py
    try:
        from step7a import ClinicalQueryEngine  # type: ignore

        _engine = ClinicalQueryEngine(**_kw)
        _ENGINE_MODE = 'full (step7a)'
        print('✅ ClinicalQueryEngine loaded from step7a  [FULL]')
        return
    except ImportError:
        pass

    # Attempt 2: step7.py on PYTHONPATH (local rename of engine file)
    try:
        from step7 import ClinicalQueryEngine  # type: ignore

        _engine = ClinicalQueryEngine(**_kw)
        _ENGINE_MODE = 'full (step7)'
        print('✅ ClinicalQueryEngine loaded from step7 module  [FULL]')
        return
    except ImportError:
        pass

    # Attempt 3: load sibling file `step7` or `step7.py` (extensionless module in repo)
    _candidates = []
    _env_engine = os.environ.get('STEP7_ENGINE_PATH', '').strip()
    if _env_engine:
        _candidates.append(Path(_env_engine))
    for base in (_here, Path('/content'), Path('/content/drive/MyDrive')):
        for name in ('step7.py', 'step7'):
            p = base / name
            if p.is_file():
                _candidates.append(p)

    _seen = set()
    for path in _candidates:
        try:
            rp = path.resolve()
        except Exception:
            continue
        if rp in _seen or not rp.is_file():
            continue
        _seen.add(rp)
        try:
            spec = importlib.util.spec_from_file_location('clinical_step7_engine', str(rp))
            if spec is None or spec.loader is None:
                continue
            mod = importlib.util.module_from_spec(spec)
            spec.loader.exec_module(mod)
            if not hasattr(mod, 'ClinicalQueryEngine'):
                continue
            _engine = mod.ClinicalQueryEngine(**_kw)
            _ENGINE_MODE = f'full ({rp.name})'
            print(f'✅ ClinicalQueryEngine loaded from {rp}  [FULL]')
            return
        except Exception as e:
            print(f'⚠  step7 load skipped {rp}: {e}')

    # Fallback: inline engine (subset of Step 7A — no synonym/specialty/concept/graph)
    try:
        from sentence_transformers import CrossEncoder as _CE
        _reranker     = _CE('cross-encoder/ms-marco-MiniLM-L-6-v2', max_length=512)
        _has_reranker = True
        print("✅ Cross-encoder available for inline engine")
    except Exception:
        _reranker     = None
        _has_reranker = False
        print("⚠  Cross-encoder unavailable — cosine-only ranking")

    class _InlineEngine:
        HYDE_SYSTEM  = (
            "You are a senior physician writing a passage from a medical textbook. "
            "Given a clinical question, write a concise paragraph (4-6 sentences) "
            "that would directly answer it using precise medical terminology. "
            "Include specific values, mechanisms, or criteria. Be factual and terse."
        )
        CHUNK_PREFIX = 'v4_chunk_'

        def __init__(self):
            self._openai = openai_client
            self._index  = pinecone_idx

        def _embed(self, text):
            r = self._openai.embeddings.create(model=EMBED_MODEL, input=text[:6000])
            return r.data[0].embedding

        def _blend(self, v1, v2, w1=0.45, w2=0.55):
            b = [w1*a + w2*b for a, b in zip(v1, v2)]
            n = sum(x*x for x in b) ** 0.5
            return [x/n for x in b] if n > 1e-9 else b

        def _hyde(self, question):
            try:
                r = self._openai.chat.completions.create(
                    model='gpt-4o-mini',
                    messages=[{'role':'system','content':self.HYDE_SYSTEM},
                               {'role':'user','content':question}],
                    max_tokens=220, temperature=0.2,
                )
                return r.choices[0].message.content.strip()
            except Exception:
                return None

        def _pc_query(self, vector, top_k=40, filter_dict=None):
            kw = {'vector': vector, 'top_k': top_k, 'include_metadata': True}
            if filter_dict: kw['filter'] = filter_dict
            try:
                matches = self._index.query(**kw).matches
            except Exception:
                return []
            return [
                {'id': m.id, 'score': float(m.score),
                 'metadata': m.metadata or {}, 'rerank_score': None}
                for m in matches if m.id.startswith(self.CHUNK_PREFIX)
            ]

        def _rerank(self, question, candidates):
            if not _has_reranker or not candidates:
                return candidates
            pairs = [(question, c['metadata'].get('text','')[:400])
                     for c in candidates[:40]]
            try:
                scores = _reranker.predict(pairs, show_progress_bar=False)
                for i, c in enumerate(candidates[:len(scores)]):
                    c['rerank_score'] = float(scores[i])
                candidates.sort(
                    key=lambda x: x['rerank_score'] if x['rerank_score'] is not None
                    else x['score'], reverse=True)
            except Exception:
                pass
            return candidates

        def query(self, question, specialty_filter=None):
            t0 = time.time()
            trace = []
            raw_vec = self._embed(question)
            base_filter = {'quality_tier': {'$in': ['high', 'medium']}}
            if specialty_filter:
                base_filter['specialty'] = {'$in': [specialty_filter]}

            candidates_raw  = self._pc_query(raw_vec, 40, base_filter)
            trace.append(f"raw: {len(candidates_raw)} candidates")

            hyde_text = self._hyde(question)
            candidates_hyde = []
            if hyde_text:
                hyde_vec        = self._embed(hyde_text)
                blended         = self._blend(raw_vec, hyde_vec)
                candidates_hyde = self._pc_query(blended, 40, base_filter)
                trace.append(f"hyde: {len(candidates_hyde)} candidates")

            seen = {}
            for lst in [candidates_raw, candidates_hyde]:
                for c in lst:
                    if c['id'] not in seen or c['score'] > seen[c['id']]['score']:
                        seen[c['id']] = c
            merged = sorted(seen.values(), key=lambda x: x['score'], reverse=True)
            merged = self._rerank(question, merged)
            final  = merged[:TOP_K]

            chunks = []
            for c in final:
                m = c['metadata']
                chunks.append({
                    'chunk_id':     c['id'],
                    'score':        c['score'],
                    'rerank_score': c.get('rerank_score'),
                    'text':         m.get('text', '')[:800],
                    'source_file':  m.get('source_file', ''),
                    'specialty':    m.get('specialty', []),
                    'concept_ids':  m.get('concept_ids', []),
                    'semantic_type':m.get('semantic_type', ''),
                    'quality_tier': m.get('quality_tier', ''),
                    'section_path': m.get('section_path', ''),
                })

            return {
                'query':   question,
                'chunks':  chunks,
                'context_chunks': [],
                'scores': {
                    'top1_cosine':  final[0]['score'] if final else 0.0,
                    'top1_rerank':  final[0].get('rerank_score') if final else None,
                    'hyde_used':    hyde_text is not None,
                    'reranker_used': _has_reranker,
                    'n_final':      len(chunks),
                },
                'pipeline_trace': trace,
                'elapsed_ms':     (time.time() - t0) * 1000,
            }

    _engine      = _InlineEngine()
    _ENGINE_MODE = 'inline — HyDE + Reranker' if _has_reranker else 'inline — HyDE only'
    print(f"✅ Using {_ENGINE_MODE}")


_bootstrap_engine()
print(f"   Engine mode: {_ENGINE_MODE}\n")


