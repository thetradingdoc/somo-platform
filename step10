def pdf_to_text_native(path):
    try:
        doc  = fitz.open(path)
        text = "\n".join(p.get_text("text") for p in doc)
        doc.close()
        return text
    except Exception:
        return ""

def pdf_to_text_ocr(path):
    print(f"    🔍 OCR running...")
    try:
        pages = convert_from_path(path, dpi=OCR_DPI)
        texts = []
        for i, img in enumerate(pages):
            texts.append(pytesseract.image_to_string(img, config='--oem 3 --psm 4'))
            print(f"    Page {i+1}/{len(pages)} ✓", end='\r')
        print()
        return "\n".join(texts)
    except Exception as e:
        print(f"    [ocr error] {e}")
        return ""

def extract_pdf_text(path):
    native = pdf_to_text_native(path)
    if len(native.strip()) >= MIN_TEXT_CHARS:
        return native, 'native'
    return pdf_to_text_ocr(path), 'ocr'

def load_image(path):
    try:
        return PILImage.open(path).convert('RGB')
    except Exception as e:
        print(f"    ⚠  Cannot open {Path(path).name}: {e}")
        return None

def image_to_b64(path):
    img = load_image(path)
    if not img: return None
    img.thumbnail(MAX_IMAGE_SIZE, PILImage.LANCZOS)
    buf = BytesIO()
    img.save(buf, format='JPEG', quality=90)
    return base64.b64encode(buf.getvalue()).decode(), 'image/jpeg'

def embed_text(text):
    r = openai_client.embeddings.create(model=EMBED_MODEL, input=text[:8000])
    return r.data[0].embedding

def _naive_retrieve(query, top_k=TOP_K):
    result = pinecone_idx.query(vector=embed_text(query), top_k=top_k,
                                include_metadata=True)
    return [{
        'chunk_id':    m.id,
        'score':       m.score,
        'rerank_score': None,
        'source_file': (m.metadata or {}).get('source_file', 'unknown'),
        'specialty':   (m.metadata or {}).get('specialty', ''),
        'concept_ids': (m.metadata or {}).get('concept_ids', []),
        'semantic_type': '',
        'quality_tier':  '',
        'section_path':  '',
        'text':        (m.metadata or {}).get('text', '[No preview]'),
    } for m in result.matches]

def gpt4o(system, user, temperature=0.1, max_tokens=2000, json_mode=False):
    kwargs = dict(
        model=VISION_MODEL,
        messages=[{"role":"system","content":system},
                  {"role":"user","content":user}],
        temperature=temperature, max_tokens=max_tokens,
    )
    if json_mode:
        kwargs['response_format'] = {"type": "json_object"}
    return openai_client.chat.completions.create(**kwargs).choices[0].message.content


