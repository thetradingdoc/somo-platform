        print(f"   Images on file     : {len([f for f in images_dir.glob('*') if f.is_file()])} files")
    else:
        metadata = {'patient_id': patient_id, 'created': datetime.now().isoformat()}
        print(f"\n🆕 New patient — ID: {patient_id}")
        for key, prompt in [('name','Full name'),('age','Age'),
                             ('sex','Sex (M/F/Other)'),('location','Location / clinic')]:
            val = input(f"  {prompt} (Enter to skip): ").strip()
            if val: metadata[key] = val
        meta_path.write_text(json.dumps(metadata, indent=2))
        print(f"✅ Profile saved → {meta_path}")

    info_parts   = [f"Patient ID: {patient_id}"]
    for k, label in [('name','Name'),('age','Age'),('sex','Sex'),('location','Location')]:
        if k in metadata: info_parts.append(f"{label}: {metadata[k]}")
    patient_info = " | ".join(info_parts)

    print("\n" + "─"*70)
    print(f"  STEP 2 — Upload Lab PDFs  →  {labs_dir}")
    print("─"*70)
    if input("\nUpload PDFs now? (y/n): ").strip().lower() == 'y':
        new_pdfs = _colab_upload(labs_dir, "PDF documents")
        if new_pdfs:
            metadata.setdefault('lab_reports', [])
            for p in new_pdfs:
                if p.name not in metadata['lab_reports']:
                    metadata['lab_reports'].append(p.name)
            meta_path.write_text(json.dumps(metadata, indent=2))
    else:
        print(f"  Using existing files in {labs_dir}")

    print("\n" + "─"*70)
    print(f"  STEP 3 — Upload Clinical Images  →  {images_dir}")
    print("─"*70)
    if input("\nUpload images now? (y/n): ").strip().lower() == 'y':
        new_imgs = _colab_upload(images_dir, "clinical images")
        if new_imgs:
            metadata.setdefault('image_files', [])
            for p in new_imgs:
                if p.name not in metadata['image_files']:
                    metadata['image_files'].append(p.name)
            meta_path.write_text(json.dumps(metadata, indent=2))
    else:
        print(f"  Using existing files in {images_dir}")

    pdf_files   = sorted(labs_dir.glob('*.pdf'))
    image_paths = [str(f) for f in sorted(images_dir.glob('*'))
                   if f.suffix.lower() in VALID_IMG_EXTS and f.is_file()]
    print(f"\n  📁 {len(pdf_files)} PDFs | {len(image_paths)} images ready")

    doc_summaries  = []
    all_imaging    = ""
    new_pdfs_list  = []
    records_path   = labs_dir / 'records.csv'
    extracted_pdfs = set(metadata.get('extracted_pdfs', []))
    new_pdfs_list  = [p for p in pdf_files if p.name not in extracted_pdfs]
    skip_pdfs      = [p for p in pdf_files if p.name in extracted_pdfs]

    if skip_pdfs:
        print(f"\n  ⏭  Skipping {len(skip_pdfs)} already-extracted PDFs")

    if new_pdfs_list:
        print(f"\n  🆕 Extracting {len(new_pdfs_list)} new PDF(s)...")
        df_new, doc_summaries, all_imaging = layer1_perception(new_pdfs_list)

        if not df_new.empty:
            if records_path.exists() and skip_pdfs:
                df_old  = pd.read_csv(records_path, parse_dates=['date'])
                df_labs = (pd.concat([df_old, df_new], ignore_index=True)
                             .drop_duplicates(subset=['source_pdf','test_name',
                                                      'value','normal_low','normal_high'])
                             .sort_values(['test_name','date']).reset_index(drop=True))
            else:
                df_labs = (df_new.drop_duplicates(
                               subset=['source_pdf','test_name','value','normal_low','normal_high'])
                               .sort_values(['test_name','date']).reset_index(drop=True))
            df_labs.to_csv(records_path, index=False)
        else:
            df_labs = pd.DataFrame(
                columns=['date','test_name','value','unit','normal_low','normal_high','flag','source_pdf'])

        metadata.setdefault('extracted_pdfs', [])
        for p in new_pdfs_list:
            if p.name not in metadata['extracted_pdfs']:
                metadata['extracted_pdfs'].append(p.name)
        metadata['doc_summaries_cache'] = doc_summaries
        metadata['imaging_cache']       = all_imaging
        meta_path.write_text(json.dumps(metadata, indent=2))
    else:
        print("\n  ✅ All PDFs cached — loading records.csv")
        doc_summaries = metadata.get('doc_summaries_cache', [])
        all_imaging   = metadata.get('imaging_cache', '')
        if not doc_summaries:
            imaging_only = [p for p in pdf_files
                            if any(t in p.name.lower() for t in ['scan','echo','book'])][:2]
            if imaging_only:
                _, doc_summaries, all_imaging = layer1_perception(imaging_only)

    if records_path.exists():
        df_labs = pd.read_csv(records_path, parse_dates=['date'])
        before  = len(df_labs)
        df_labs = (df_labs
                   .drop_duplicates(subset=['source_pdf','test_name','value','normal_low','normal_high'])
                   .sort_values(['test_name','date']).reset_index(drop=True))
        after = len(df_labs)
        df_labs.to_csv(records_path, index=False)
        cleaned = f" (cleaned {before-after} duplicates)" if before > after else ""
        print(f"\n  💾 {after} lab records{cleaned}")
        display(df_labs.reset_index(drop=True))
    else:
        df_labs = pd.DataFrame(
            columns=['date','test_name','value','unit','normal_low','normal_high','flag','source_pdf'])
        print("\n  ⚠  No lab records found.")

    print(f"\n  📋 Document summary ({len(pdf_files)} files):")
    all_summaries = {d['filename']:d for d in (metadata.get('doc_summaries_cache') or [])}
    for d in doc_summaries: all_summaries[d['filename']] = d
    for fname in sorted(all_summaries.keys()):
        d      = all_summaries[fname]
        cached = " [cached]" if fname in extracted_pdfs and \
                 fname not in [p.name for p in new_pdfs_list] else ""
        print(f"     {fname:45s} → {d.get('type','?')}"
              f"{' ('+str(d.get('lab_count',0))+' labs)' if d.get('lab_count') else ''}"
              f"{' [imaging]' if d.get('has_imaging') else ''}{cached}")

    if records_path.exists():
        df_ts = pd.read_csv(records_path, parse_dates=['date'])
        if not df_ts.empty:
            print("\n" + "─"*70)
            print("  STEP 5 — Lab Trend Plots")
            print("─"*70)
            plot_lab_trends(df_ts, save_dir=charts_dir)
            df_labs = df_ts

    lab_summary     = build_lab_summary(df_labs)
    signal_analysis = layer2_signal_analysis(df_labs, all_imaging)

    if image_paths:
        print(f"\n  Images for visual fusion:")
        for p in image_paths:
            print(f"    - {Path(p).name}")
            try:
                img = load_image(p)
                if img:
                    img.thumbnail((400, 400))
                    buf = BytesIO()
                    img.save(buf, format='JPEG')
                    display(IPyImage(data=buf.getvalue()))
            except Exception:
                pass

    visual_fusion = layer3_visual_fusion(image_paths, signal_analysis)
    hypotheses    = layer4_systemic_hypothesis(signal_analysis, visual_fusion, patient_info)
    rag_evidence  = layer5_rag_validation(hypotheses, signal_analysis)

    report = layer6_audit_report(
        patient_info=patient_info, doc_summaries=doc_summaries,
        signal_analysis=signal_analysis, visual_fusion=visual_fusion,
        hypotheses=hypotheses, rag_evidence=rag_evidence,
        lab_summary=lab_summary, all_imaging=all_imaging,
    )

    print("\n" + "="*70)
    print("  CLINICAL REPORT  (v3 — Top 3 Differentials)")
    print("="*70 + "\n")
    display(Markdown(report))

    ts          = datetime.now().strftime('%Y%m%d_%H%M%S')
    report_path = base / f"clinical_report_{ts}.md"
    report_path.write_text(report)
    print(f"\n💾 Report saved → {report_path}")

    chain_path = save_reasoning_chain(base, {
        'patient_info':               patient_info,
        'doc_summaries':              doc_summaries,
        'lab_records':                df_labs,
        'signal_analysis':            signal_analysis,
        'visual_fusion':              visual_fusion,
        'differential_diagnoses':     hypotheses.get('differential_diagnoses', []),
        'alcohol_caveat':             hypotheses.get('alcohol_history_caveat', ''),
        'engine_mode':                _ENGINE_MODE,
        'rag_differentials_queried':  list(rag_evidence.get('differential_evidence', {}).keys()),
        'rag_clusters_queried':       list(rag_evidence.get('cluster_evidence', {}).keys()),
    })

    log = {
        'timestamp':              datetime.now().isoformat(),
        'patient_id':             patient_id,
        'patient_name':           metadata.get('name',''),
        'pdfs_processed':         len(pdf_files),
        'lab_rows':               len(df_labs),
        'images_analysed':        len(image_paths),
        'signal_clusters':        len(signal_analysis.get('signal_clusters', [])),
        'differentials_ranked':   [d.get('name') for d in
                                   hypotheses.get('differential_diagnoses', [])],
        'engine_mode':            _ENGINE_MODE,
        'report_path':            str(report_path),
        'chain_path':             str(chain_path),
    }
    with open(base / 'pipeline_log.jsonl', 'a') as lf:
        lf.write(json.dumps(log, default=str) + "\n")
    print(f"📝 Run logged  (engine_mode={_ENGINE_MODE})")
    print("\n✅ Pipeline v3 complete.\n")
    return report


