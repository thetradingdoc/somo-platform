def process_patient(patient_id=None):

    print("\n" + "="*70)
    print("  PATIENT RAG PIPELINE  v3  —  DEEP REASONING ARCHITECTURE")
    print("  Layer 4: Top 3 Differentials  |  Layer 5: Step 7A Engine")
    print("="*70)

    print("\n" + "─"*70)
    print("  STEP 1 — Patient Details")
    print("─"*70)

    if not patient_id:
        patient_id = input("\nEnter patient ID: ").strip()
    if not patient_id:
        print("❌  No patient ID."); return

    base       = Path(PATIENT_BASE) / patient_id
    labs_dir   = base / 'labs'
    images_dir = base / 'images'
    charts_dir = base / 'charts'
    meta_path  = base / 'metadata.json'

