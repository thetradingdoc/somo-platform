_L1_SYSTEM = """You are a medical document parser. Extract ALL information from the text.

Return ONLY a JSON object:
{
  "document_type": "lab_results|imaging_report|echocardiogram|prescription|referral|discharge_summary|clinical_notes|other",
  "date": "YYYY-MM-DD or empty string",
  "labs": [
    {
      "test_name": "standardised name (HGB, WBC, AST, Creatinine etc.)",
      "value": 13.5,
      "unit": "g/dL",
      "normal_low": 12.0,
      "normal_high": 16.0,
      "flag": "normal|high|low|critical"
    }
  ],
  "imaging_findings": "full text of any imaging/ultrasound/echo findings verbatim",
  "clinical_notes": "doctor comments, diagnoses, prescriptions, referral reasons (max 500 chars)"
}

Rules:
- labs: only include if you have BOTH a numeric value AND a reference range
- Standardise: Haemoglobin→HGB, WBC→WBC, SGOT→AST, SGPT→ALT etc.
- imaging_findings: include ALL text from ultrasound, echo, X-ray reports verbatim
- Return ONLY the JSON, no markdown fences"""


def layer1_perception(pdf_files):
    print("\n" + "─"*60)
    print("  LAYER 1 — PERCEPTION")
    print("─"*60)

    all_dfs, doc_summaries, imaging_texts = [], [], []

    for i, pdf in enumerate(pdf_files, 1):
        print(f"\n  [{i}/{len(pdf_files)}] {pdf.name}")
        text, method = extract_pdf_text(str(pdf))
        print(f"    method={method} | chars={len(text.strip())}")

        try:
            result = json.loads(gpt4o(
                system=_L1_SYSTEM,
                user=f"Filename: {pdf.name}\n\n{text[:6000]}",
                temperature=0.0, max_tokens=2500, json_mode=True
            ))
        except Exception as e:
            print(f"    ⚠  Parse error: {e}")
            result = {'document_type':'error','date':'','labs':[],'imaging_findings':'','clinical_notes':''}

        doc_type = result.get('document_type','unknown')
        imaging  = result.get('imaging_findings','') or ''
        notes    = result.get('clinical_notes','') or ''
        labs     = result.get('labs',[])
        date_str = result.get('date','')

        try:
            date_val = pd.to_datetime(date_str, errors='coerce')
            if pd.isna(date_val): date_val = pd.Timestamp.now()
        except Exception:
            date_val = pd.Timestamp.now()

        rows = []
        for lab in labs:
            try:
                val  = float(lab.get('value', 0))
                low  = float(lab.get('normal_low', 0))
                high = float(lab.get('normal_high', 0))
                if low >= high or val < 0: continue
                rows.append({
                    'date':        date_val,
                    'test_name':   str(lab.get('test_name','')).strip(),
                    'value':       val,
                    'unit':        str(lab.get('unit','')).strip(),
                    'normal_low':  low,
                    'normal_high': high,
                    'flag':        str(lab.get('flag','normal')).strip(),
                    'source_pdf':  pdf.name,
                })
            except (TypeError, ValueError):
                continue

        if rows:
            all_dfs.append(pd.DataFrame(rows))
            print(f"    ✅ {doc_type} → {len(rows)} lab values")
        else:
            print(f"    ℹ  {doc_type} → no lab values")

        if imaging.strip():
            imaging_texts.append(f"[{pdf.name}]\n{imaging.strip()}")

        doc_summaries.append({
            'filename':    pdf.name,
            'type':        doc_type,
            'date':        date_str,
            'lab_count':   len(rows),
            'has_imaging': bool(imaging.strip()),
            'notes':       notes[:200],
        })

    df = (pd.concat(all_dfs, ignore_index=True)
            .drop_duplicates(subset=['date','test_name','value'])
          if all_dfs else
          pd.DataFrame(columns=['date','test_name','value','unit',
                                 'normal_low','normal_high','flag','source_pdf']))

    all_imaging = "\n\n".join(imaging_texts)
    print(f"\n  ✅ Layer 1: {len(df)} records | {len(imaging_texts)} imaging | "
          f"{len(doc_summaries)} docs")
    return df, doc_summaries, all_imaging


