def layer2_signal_analysis(df_labs, all_imaging):
    print("\n" + "─"*60)
    print("  LAYER 2 — SIGNAL ANALYSIS")
    print("─"*60)

    df = df_labs.copy()
    df['date'] = pd.to_datetime(df['date'])
    lab_lines  = []

    for test in sorted(df['test_name'].unique()):
        sub  = df[df['test_name'] == test].sort_values('date')
        lo   = sub['normal_low'].iloc[-1]
        hi   = sub['normal_high'].iloc[-1]
        unit = sub['unit'].iloc[-1] if 'unit' in sub.columns else ''
        flag = str(sub['flag'].iloc[-1]) if 'flag' in sub.columns else 'normal'
        tpts = [f"{r['date'].strftime('%Y-%m-%d')}:{r['value']}"
                for _, r in sub.iterrows()]
        lab_lines.append(
            f"{test} | unit:{unit} | ref:{lo}-{hi} | flag:{flag} | "
            f"timepoints:[{', '.join(tpts)}]"
