# Production API (live backend origin)
# NOTE: Keep this as the real API origin until edge proxy (/api/* -> backend) is confirmed.
REACT_APP_API_BASE=https://api.myskinandcare.com

# Set your merchant UUID before build (checkout / catalog):
REACT_APP_MERCHANT_ID=provider-1

# Optional merchant warning banner toggle (strict checkout gating still applies):
# REACT_APP_SHOW_MERCHANT_BANNER=0

# Optional checkout maintenance kill-switch for landing entry points:
# REACT_APP_CHECKOUT_MAINTENANCE_MODE=0
