# Copy to .env.local for local development (never commit .env.local).

# Required on non-localhost builds: merchant UUID so checkout links include provider_id and the API can resolve catalog + quotes.
# Localhost (127.0.0.1 / localhost) is exempt — cart icon and ingredient chat stay enabled without this.
# REACT_APP_MERCHANT_ID=

# Optional: set to 1 to show merchant-missing banner in non-localhost builds.
# REACT_APP_SHOW_MERCHANT_BANNER=0

# Optional: set to 1/true to hide assistant checkout entry points (Start Analysis / Ask now / panda button).
# REACT_APP_CHECKOUT_MAINTENANCE_MODE=0

# API origin for catalog + assistant (middleware). Use 127.0.0.1 if you open the app at 127.0.0.1.
# Copy to .env.local and restart the dev server. Do not use placeholder characters (…) in the URL.
# Local dev: if omitted, localhost/127.0.0.1 defaults to http://localhost:4000 (or 127.0.0.1:4000) except when the app itself runs on port 4000.
# Production: required when the SPA is on a different host than the API (e.g. Firebase + api.example.com). Set before `npm run build`.
REACT_APP_API_BASE=http://127.0.0.1:4000

# Optional: clinic UUID for anonymous landing assistant (middleware DEFAULT_CLINIC_ID if omitted).
# REACT_APP_DEFAULT_CLINIC_ID=

# Optional: path prefix for checkout-chat.html (default /unified-dashboard/patients).
# REACT_APP_PATIENT_PORTAL_PREFIX=/unified-dashboard/patients
