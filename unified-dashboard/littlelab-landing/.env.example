# Copy to .env.local for local development (never commit .env.local).

# Required on non-localhost builds: merchant UUID so checkout links include provider_id and the API can resolve catalog + quotes.
# Localhost (127.0.0.1 / localhost) is exempt — cart icon and ingredient chat stay enabled without this.
# REACT_APP_MERCHANT_ID=

# Optional: API origin for catalog fetch (defaults: localhost:4010/4000 in dev, else same origin).
# REACT_APP_API_BASE=http://localhost:4000

# Optional: path prefix for checkout-chat.html (default /unified-dashboard/patients).
# REACT_APP_PATIENT_PORTAL_PREFIX=/unified-dashboard/patients
