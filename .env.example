## Environment example (mvp-55, mvp-56)
## Copy to `.env` for local dev. Never commit `.env`.

NODE_ENV=development

# Base URLs
BASE_URL=http://localhost:4000
API_BASE_URL=http://localhost:4000

# Database (dev/staging/prod should be separate)
DB_PATH=./middleware-dev.db

# Patient portal
PATIENT_SESSION_ABSOLUTE_TTL_HOURS=24
PATIENT_SESSION_INACTIVITY_TTL_MINUTES=30
PATIENT_JOIN_EARLY_MINUTES=10
PATIENT_JOIN_LATE_MINUTES=15
PATIENT_UPLOAD_MAX_MB=10
PATIENT_DOCUMENT_SIGNED_URL_TTL_SECONDS=300

# Optional: Azure Blob Storage (mvp-68)
AZURE_STORAGE_ACCOUNT=
AZURE_STORAGE_KEY=
AZURE_STORAGE_CONTAINER=patient-documents

# Email (optional; if not set, emails are logged to console)
SMTP_HOST=
SMTP_PORT=587
SMTP_USER=
SMTP_PASSWORD=
SMTP_FROM=

# Stripe / LiveKit (optional for local)
STRIPE_SECRET_KEY=
STRIPE_PUBLISHABLE_KEY=
LIVEKIT_URL=
LIVEKIT_API_KEY=
LIVEKIT_API_SECRET=

# Clinic (required for triage/booking when request has no clinic_id)
DEFAULT_CLINIC_ID=clinic-default

# Voice channel (traffic gate: 0=off, 1=on). When off, voice calls rejected; chat unchanged.
VOICE_AGENT_ENABLED=0
# When 1, use orchestrator only for voice (no AgentBrain fallback). Set to 1 in staging after Phases 1–4 validated.
VOICE_ORCHESTRATE_ONLY=1

# Retention
RETENTION_IDEMPOTENCY_DAYS=2
RETENTION_PATIENT_PORTAL_SESSIONS_DAYS=14
RETENTION_HIPAA_ACCESS_LOG_DAYS=90
RETENTION_PATIENT_DOCUMENTS_DAYS=3650

